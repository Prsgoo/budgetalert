{
  "ConnectionStrings": {
    "Default": "Server=<name>.database.windows.net; Database=BudgetAlert; Authentication=Active Directory Default; TrustServerCertificate=False; Encrypt=True;"
  },
  "Messaging": {
    "Provider": "AzureServiceBus",
    "AzureServiceBus": {
      "FullyQualifiedNamespace": "<name>.servicebus.windows.net",
      "QueueName": "budget-events"
    }
  },
  "Auth": {
    "Enabled": true,
    "AzureAd": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "<your-tenant-id>",
      "ClientId": "<your-client-id>",
      "Audience": "api://<your-client-id>"
    }
  }
}
